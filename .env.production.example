# Production flavor values (copy to the git-ignored `.env.production` and
# fill in real values; never commit the filled copy). Consumed with:
# flutter run --flavor production -t lib/main_production.dart --dart-define-from-file=.env.production
# Variable names only here — no secrets in version control.
# Only the anon PUBLIC key belongs here; a service-role key is refused at
# startup by the anon-key guard and must never be placed on the client.
APP_FLAVOR=production
APP_NAME=LegalHub
APPLICATION_ID=com.legalhub.app
API_BASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
