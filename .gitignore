.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Local environment configuration and secrets
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example

# Design reference archives (visual reference only; not part of B1 source)
/stitch_legalhub_mobile_app/
/stitch_legalhub_mobile_app.rar

# Local tool scratch directory (not project source)
.commandcode/
.freebuff/

# Local tool/IDE configuration (not project source; repo-local rule so it does
# not depend on a machine-level global gitignore)
.openclaude/

# Supabase CLI local scratch state (regenerated by supabase link)
/supabase/.temp/

# Agent/tooling scratch directories and workspace identity files (not project
# source). Repo-local rules so they do not depend on a machine-level global
# gitignore (owner decision OI-D7.1, 2026-09-22).
.agents/
.cluster/
.flutter
.flutter_tool_state
.openclaw/
.opencode/
.workbuddy-ai/
AGENTS.md
HEARTBEAT.md
IDENTITY.md
SOUL.md
TOOLS.md
USER.md

# Release signing secrets (audit doc §12.19): the keystore lives outside the
# repo (C:/Users/ASUS/keystores/); these rules stop any local copy or the
# credentials file from ever being committed by accident.
android/key.properties
*.jks
*.keystore

# Session working state (audit doc §12.20): memory notes and local tool
# config are working files, not product source — keep them out of the repo.
memory/
MEMORY.md
config/
