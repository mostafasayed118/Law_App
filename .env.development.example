# Development flavor values (copy to the git-ignored `.env.development` and
# fill in real values; never commit the filled copy). Consumed with:
# flutter run --flavor development -t lib/main_development.dart --dart-define-from-file=.env.development
# Variable names only here — no secrets in version control.
APP_FLAVOR=development
APP_NAME=LegalHub Dev
APPLICATION_ID=com.legalhub.app.dev
API_BASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
