<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for the Supabase auth/data provider in release builds;
         debug/profile manifests already carry it via the Flutter template. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Video consultations (LiveKit): camera/microphone capture is requested
         at the first call. Both hardware features are optional so the app
         stays installable on devices without a camera or microphone. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Phase 4.1 custom-scheme entry for the link-based + PKCE
                  recovery variant and the accept-invite share link. The
                  scheme is per flavor (`development` →
                  com.legalhub.app.dev, `production` → com.legalhub.app) from
                  build.gradle.kts and matches the Supabase dashboard
                  Redirect URL (`<scheme>://auth/v1/callback`).
                  AUDIT NOTE (custom-scheme hijack): any app can register a
                  custom scheme, so these filters cannot be trusted to prove
                  provenance. They stay because shipped producers still emit
                  them: `AppLinkParser.acceptInviteUri` (share link) and
                  `SupabaseAuthApiImpl`'s recovery `emailRedirectTo`. They are
                  host-scoped to the two real entry points (accept-invite and
                  the auth callback) so unrelated custom-scheme URIs do not
                  launch the app. Removal is gated on switching both producers
                  to the verified https links + allowlisting the https
                  redirect; exact steps in
                  docs/deep_link_release_checklist.md. Dev flavor unaffected. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="${deepLinkScheme}" android:host="accept-invite"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="${deepLinkScheme}" android:host="auth" android:path="/v1/callback"/>
            </intent-filter>
            <!-- Verified App Links (audit: custom-scheme hijack): the OS
                  verifies `legalhub.app` against
                  `https://legalhub.app/.well-known/assetlinks.json` before
                  routing here, so a third-party app cannot intercept the
                  https invite/recovery links. `autoVerify` is what promotes
                  this filter to verified; without it the link opens the
                  disambiguation dialog. NOTE: this protects ONLY the https
                  filter below — the custom-scheme filters above stay
                  hijackable by any app registering the same scheme.
                  OWNER STEP: deploy `web/.well-known/assetlinks.json` (the
                  release-cert SHA-256 is filled in) and run the checks in
                  docs/deep_link_release_checklist.md. Keep the custom-scheme
                  filters until the producers switch to https. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="legalhub.app" android:pathPrefix="/accept-invite"/>
                <data android:scheme="https" android:host="legalhub.app" android:pathPrefix="/auth/v1/callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher on Android 11+: lets the app resolve an https VIEW
             handler for signed matter-file links. No permissions. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
