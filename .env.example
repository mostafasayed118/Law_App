# Legacy single-env template (flavor-less `flutter run
# --dart-define-from-file=.env`, resolves to the production flavor).
# Prefer the per-flavor templates: `.env.development.example` and
# `.env.production.example`. Variable names only. Supply local values outside
# VCS; never use a service-role key on the client.
APP_FLAVOR=
APP_NAME=
APPLICATION_ID=
API_BASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Payments posture: disabled | demo | live (default: disabled).
# PAYMENTS_MODE=disabled
